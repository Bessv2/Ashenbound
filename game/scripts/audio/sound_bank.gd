## Music and beds: track → loudness in dB (the files are all -18 LUFS).
## Each loops until changed.
const TRACKS: Dictionary[StringName, float] = {
	&"music_title": 0.0,
	&"music_crypt": 0.0,
	&"music_catacombs": 0.0,
	&"music_combat": -1.0,
	&"music_boss": 0.0,
	&"ambience_dungeon": -8.0,
}


## Whether `cue` has files to play.
static func has(cue: StringName) -> bool:
	return SoundFiles.FILES.has(cue) and not SoundFiles.FILES[cue].is_empty()


## How `cue` plays: DEFAULT overlaid with its MIX entry.
static func mix(cue: StringName) -> Dictionary:
	return DEFAULT.merged(MIX.get(cue, {}), true)
