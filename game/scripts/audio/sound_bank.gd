class_name SoundBank
extends RefCounted
## How each sound cue is played: its loudness, how much its pitch varies from
## one play to the next, its bus, and how soon it may play again. The files
## behind each cue are in SoundFiles (generated by tools/audio/import_audio.py);
## docs/AUDIO.md says where they come from and what each cue is for.

## Combat and the world: heard from where they happen, with a little of the
## crypt's reverb.
const WORLD := &"World"
## The interface and stingers: flat, no reverb.
const UI := &"Ui"
## Music, under the Music volume.
const MUSIC := &"Music"
## Background beds, under the effects volume.
const AMBIENCE := &"Ambience"

## The defaults for a cue missing from MIX, and for any key a MIX entry
## leaves out: "db" loudness in dB, "pitch" the random pitch variation (0.06
## is ±6%), "bus", and "gap" the seconds before the same cue may play again
## (so a sweep hitting six skeletons plays one rattle, not six stacked).
const DEFAULT := {"db": -4.0, "pitch": 0.06, "bus": WORLD, "gap": 0.05}

