[node name="Demon" type="CharacterBody3D" node_paths=PackedStringArray("attack", "special_attack", "health", "visual", "navigation")]
collision_layer = 4
collision_mask = 7
script = ExtResource("1_controller")
movement = ExtResource("2_movement")
behavior = ExtResource("3_behavior")
