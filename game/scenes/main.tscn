[node name="Enemies" type="Node3D" parent="."]

[node name="TrainingDummyEast" parent="Enemies" instance=ExtResource("8_dummy")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 5, 0, 0)

[node name="TrainingDummyNorth" parent="Enemies" instance=ExtResource("8_dummy")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -5)

[node name="TrainingDummyWest" parent="Enemies" instance=ExtResource("8_dummy")]
