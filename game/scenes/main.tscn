[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/core/pause_controller.gd" id="2_pause"]
[ext_resource type="PackedScene" path="res://scenes/dungeon/crypt.tscn" id="3_level"]
[ext_resource type="PackedScene" path="res://scenes/player/warden.tscn" id="4_player"]
[ext_resource type="PackedScene" path="res://scenes/camera/isometric_camera_rig.tscn" id="5_camera"]
[ext_resource type="PackedScene" path="res://ui/hud/hud.tscn" id="6_hud"]
[ext_resource type="PackedScene" path="res://ui/pause_menu/pause_menu.tscn" id="7_menu"]
[ext_resource type="PackedScene" path="res://ui/death_screen/death_screen.tscn" id="9_death"]
[ext_resource type="Script" path="res://scripts/dungeon/run_controller.gd" id="13_run"]
[ext_resource type="Script" path="res://scripts/core/perf_log.gd" id="12_perf"]
[ext_resource type="Script" path="res://scripts/items/loot_dropper.gd" id="14_loot"]
[ext_resource type="Script" path="res://ui/inventory/inventory_panel.gd" id="15_inventory"]
[ext_resource type="Script" path="res://ui/skills/skill_tree_panel.gd" id="16_skills"]

[node name="Main" type="Node3D"]
script = ExtResource("1_main")
level_scene = ExtResource("3_level")

[node name="PauseController" type="Node" parent="."]
script = ExtResource("2_pause")

[node name="PerfLog" type="Node" parent="."]
script = ExtResource("12_perf")

[node name="Player" parent="." node_paths=PackedStringArray("camera") instance=ExtResource("4_player")]
camera = NodePath("../CameraRig/Camera3D")

[node name="CameraRig" parent="." node_paths=PackedStringArray("target") instance=ExtResource("5_camera")]
target = NodePath("../Player")

[node name="HUD" parent="." instance=ExtResource("6_hud")]

[node name="DeathScreen" parent="." instance=ExtResource("9_death")]
visible = false

[node name="PauseMenu" parent="." instance=ExtResource("7_menu")]
visible = false

[node name="Run" type="Node" parent="." node_paths=PackedStringArray("player_health")]
script = ExtResource("13_run")
player_health = NodePath("../Player/Health")

[node name="Loot" type="Node" parent="."]
script = ExtResource("14_loot")

[node name="Inventory" type="CanvasLayer" parent="."]
script = ExtResource("15_inventory")

[node name="Skills" type="CanvasLayer" parent="."]
script = ExtResource("16_skills")
