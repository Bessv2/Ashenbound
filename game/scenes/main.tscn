[node name="North" type="Marker3D" parent="Enemies/Encounter"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -16)

[node name="NorthEast" type="Marker3D" parent="Enemies/Encounter"]
