[node name="Warden" type="CharacterBody3D" node_paths=PackedStringArray("visual", "attack", "health", "dodge", "abilities")]
collision_layer = 2
collision_mask = 5
script = ExtResource("1_controller")
stats = ExtResource("2_stats")
visual = NodePath("Visual")
attack = NodePath("MeleeAttack")
health = NodePath("Health")
dodge = NodePath("Dodge")
abilities = [NodePath("Cleave"), NodePath("Guard"), NodePath("Brand")]

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
