anchor_left = 1.0
anchor_right = 1.0
offset_left = -480.0
offset_top = 140.0
offset_right = -32.0
offset_bottom = 360.0
grow_horizontal = 0
mouse_filter = 2
theme_override_constants/separation = 4

[node name="TouchJoystick" type="Control" parent="Root"]
