[gd_scene format=3]

[ext_resource type="Script" path="res://ui/hud/hud.gd" id="1_hud"]
[ext_resource type="Script" path="res://ui/hud/touch_joystick.gd" id="2_joystick"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="TopBar" type="MarginContainer" parent="Root"]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
grow_horizontal = 2
mouse_filter = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 32

[node name="Row" type="HBoxContainer" parent="Root/TopBar"]
layout_mode = 2
mouse_filter = 2

[node name="TitleBlock" type="VBoxContainer" parent="Root/TopBar/Row"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Root/TopBar/Row/TitleBlock"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "ASHENBOUND"

[node name="DebugLabel" type="Label" parent="Root/TopBar/Row/TitleBlock"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "FPS --"

[node name="PauseButton" type="Button" parent="Root/TopBar/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(96, 96)
layout_mode = 2
size_flags_vertical = 0
focus_mode = 0
text = "II"

[node name="TouchJoystick" type="Control" parent="Root"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_top = -420.0
offset_right = 560.0
grow_vertical = 0
script = ExtResource("2_joystick")

[node name="ControlsHint" type="Label" parent="Root"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
