[gd_scene format=3]

[ext_resource type="Script" path="res://ui/hud/hud.gd" id="1_hud"]
[ext_resource type="Script" path="res://ui/hud/touch_joystick.gd" id="2_joystick"]
[ext_resource type="Script" path="res://ui/hud/touch_action_button.gd" id="3_action_button"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="TopBar" type="MarginContainer" parent="Root"]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
grow_horizontal = 2
mouse_filter = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 32

[node name="Row" type="HBoxContainer" parent="Root/TopBar"]
layout_mode = 2
mouse_filter = 2

[node name="TitleBlock" type="VBoxContainer" parent="Root/TopBar/Row"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Root/TopBar/Row/TitleBlock"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "ASHENBOUND"

[node name="HealthRow" type="HBoxContainer" parent="Root/TopBar/Row/TitleBlock"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="HealthBar" type="ProgressBar" parent="Root/TopBar/Row/TitleBlock/HealthRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(260, 18)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
value = 100.0
show_percentage = false

[node name="HealthText" type="Label" parent="Root/TopBar/Row/TitleBlock/HealthRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "100 / 100"

[node name="DebugLabel" type="Label" parent="Root/TopBar/Row/TitleBlock"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "FPS --"

[node name="GoldLabel" type="Label" parent="Root/TopBar/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 0
theme_type_variation = &"HeaderLabel"
theme_override_colors/font_color = Color(0.95, 0.75, 0.3, 1)
text = "0 gold"

[node name="PauseButton" type="Button" parent="Root/TopBar/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(96, 96)
layout_mode = 2
size_flags_vertical = 0
focus_mode = 0
text = "II"

[node name="LootFeed" type="VBoxContainer" parent="Root"]
unique_name_in_owner = true
layout_mode = 1
