[gd_resource type="Resource" script_class="EncounterData" format=3]

[ext_resource type="Script" path="res://scripts/encounters/encounter_data.gd" id="1_encounter"]
[ext_resource type="Script" path="res://scripts/encounters/wave_data.gd" id="2_wave"]
[ext_resource type="PackedScene" path="res://scenes/enemies/skeleton_warrior.tscn" id="3_skeleton"]

[sub_resource type="Resource" id="Resource_wave1"]
script = ExtResource("2_wave")
enemies = Array[PackedScene]([ExtResource("3_skeleton"), ExtResource("3_skeleton"), ExtResource("3_skeleton")])
markers = PackedStringArray("North", "East", "West")

[sub_resource type="Resource" id="Resource_wave2"]
script = ExtResource("2_wave")
enemies = Array[PackedScene]([ExtResource("3_skeleton"), ExtResource("3_skeleton"), ExtResource("3_skeleton")])
markers = PackedStringArray("NorthEast", "South", "NorthWest")

[resource]
script = ExtResource("1_encounter")
waves = Array[ExtResource("2_wave")]([SubResource("Resource_wave1"), SubResource("Resource_wave2")])
