[gd_resource type="Resource" script_class="EncounterData" format=3]

[ext_resource type="Script" path="res://scripts/encounters/encounter_data.gd" id="1_encounter"]
[ext_resource type="Script" path="res://scripts/encounters/wave_data.gd" id="2_wave"]
[ext_resource type="PackedScene" path="res://scenes/enemies/ghoul.tscn" id="3_ghoul"]
[ext_resource type="PackedScene" path="res://scenes/enemies/fallen_knight.tscn" id="4_knight"]

[sub_resource type="Resource" id="Resource_wave1"]
script = ExtResource("2_wave")
enemies = Array[PackedScene]([ExtResource("4_knight"), ExtResource("3_ghoul"), ExtResource("3_ghoul"), ExtResource("3_ghoul")])
markers = PackedStringArray("North", "East", "West", "NorthEast")

[sub_resource type="Resource" id="Resource_wave2"]
script = ExtResource("2_wave")
enemies = Array[PackedScene]([ExtResource("3_ghoul"), ExtResource("3_ghoul"), ExtResource("3_ghoul"), ExtResource("3_ghoul"), ExtResource("3_ghoul")])
markers = PackedStringArray("North", "NorthEast", "NorthWest", "East", "West")

[resource]
script = ExtResource("1_encounter")
waves = Array[ExtResource("2_wave")]([SubResource("Resource_wave1"), SubResource("Resource_wave2")])
